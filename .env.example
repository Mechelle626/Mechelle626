# Copy to apps/web/.env.local. No credentials should be committed.
DATABASE_URL=postgresql://user:password@localhost:5432/braincraze
APP_BASE_URL=http://localhost:3000
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# SMTP for real mail; transport enforces TLS. Configure a verified sender.
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Local-only alternative: MAIL_MODE=outbox and ALLOW_LOCAL_OUTBOX=true.
# Outbox works only for APP_BASE_URL localhost/127.0.0.1; never deployed delivery.
ALLOW_LOCAL_OUTBOX=false
# Optional absolute local outbox directory. Defaults to .local/mail in the Next app.
MAIL_OUTBOX_DIR=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM PKCS8 signing key, with literal \n for newlines if necessary.
APPLE_PRIVATE_KEY=
# Set only behind a trusted proxy that removes caller-supplied X-Forwarded-For.
TRUST_PROXY=false
# Step 3: select ONE active provider: turnstile (default), recaptcha (v2 checkbox), hcaptcha.
CAPTCHA_PROVIDER=turnstile
# Public site keys are returned to the widget; secret keys stay server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
# Register the exact APP_BASE_URL hostname in your provider's site configuration.
# Shared private, encrypted school/identity document store. No public file route exists.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SCHOOL_DOCUMENT_KEY=
SCHOOL_DOCUMENT_DIR=
# Optional absolute executable path. Default: clamscan (requires real signatures).
SCHOOL_SCANNER_EXECUTABLE=
# Steps 8-9: Stripe hosted Checkout and Billing Portal.
# Create USD recurring prices: monthly 799 cents, yearly 6999 cents.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=
# Configure the Stripe Billing Portal and the /api/stripe/webhook endpoint.

# Optional draft translation generation; configure securely, never put credentials in Git.
# API-compatible endpoint base including /v1; adjust key destination for other providers.
I18N_AI_BASE_URL=https://api.openai.com/v1
I18N_AI_MODEL=
I18N_AI_API_KEY=
