diff --git a/src/lib/verificationProgress.ts b/src/lib/verificationProgress.ts
new file mode 100644
index 0000000..d84eaa4
--- /dev/null
+++ b/src/lib/verificationProgress.ts
@@ -0,0 +1,73 @@
+import { supabase } from "./supabase";
+
+export const reviewStatuses = [
+  "pending_email",
+  "awaiting_upload",
+  "queued",
+  "processing",
+  "manual_review",
+  "needs_reupload",
+  "approved",
+  "rejected",
+] as const;
+export type ReviewStatus = (typeof reviewStatuses)[number];
+export type VerificationProgress = {
+  emailVerified: boolean;
+  schoolVerified: boolean;
+  reviewStatus: ReviewStatus | null;
+};
+export type ProgressStep = {
+  key: "account" | "email" | "submission" | "review";
+  state: "complete" | "current" | "locked";
+};
+
+export function progressSteps(
+  progress: VerificationProgress | null,
+  signedIn: boolean,
+): ProgressStep[] {
+  const email = signedIn && Boolean(progress?.emailVerified);
+  const submitted =
+    email &&
+    ["queued", "processing", "manual_review", "approved"].includes(
+      progress?.reviewStatus ?? "",
+    );
+  const approved =
+    submitted &&
+    progress?.reviewStatus === "approved" &&
+    Boolean(progress.schoolVerified);
+  const steps = [
+    { key: "account" as const, done: signedIn },
+    { key: "email" as const, done: email },
+    { key: "submission" as const, done: submitted },
+    { key: "review" as const, done: approved },
+  ];
+  let locked = false;
+  return steps.map(({ key, done }) => {
+    const state = locked ? "locked" : done ? "complete" : "current";
+    if (!done) locked = true;
+    return { key, state };
+  });
+}
+
+// No user ID parameter: the database chooses auth.uid(), not a client-supplied owner.
+export async function loadVerificationProgress(): Promise<VerificationProgress> {
+  const { data, error } = await supabase.rpc("my_verification_progress");
+  if (error) throw error;
+  if (
+    !data ||
+    typeof data.email_verified !== "boolean" ||
+    typeof data.school_verified !== "boolean" ||
+    !(
+      data.review_status === null || reviewStatuses.includes(data.review_status)
+    )
+  ) {
+    throw new Error(
+      "The verification status could not be validated. Please retry.",
+    );
+  }
+  return {
+    emailVerified: data.email_verified,
+    schoolVerified: data.school_verified,
+    reviewStatus: data.review_status,
+  };
+}
diff --git a/supabase/migrations/004_verification_progress.sql b/supabase/migrations/004_verification_progress.sql
new file mode 100644
index 0000000..a1fff87
--- /dev/null
+++ b/supabase/migrations/004_verification_progress.sql
@@ -0,0 +1,29 @@
+-- Read-only progress for the authenticated owner. Apply after migrations 001–003.
+-- No trust, CAPTCHA, role, badge, or approval is granted by this function.
+begin;
+create or replace function public.my_verification_progress()
+returns jsonb
+language plpgsql
+stable
+security definer
+set search_path = public
+as $$
+declare
+  me uuid := auth.uid();
+  confirmed boolean;
+  affiliation boolean;
+  latest_status text;
+begin
+  if me is null then raise exception 'not authenticated'; end if;
+  select email_confirmed_at is not null into confirmed from auth.users where id = me;
+  if not found then raise exception 'account not found'; end if;
+  select school_verified_at is not null into affiliation from public.profiles where id = me;
+  select status into latest_status from public.verification_requests
+    where user_id = me order by created_at desc, id desc limit 1;
+  return jsonb_build_object('email_verified', confirmed,
+    'school_verified', coalesce(affiliation, false), 'review_status', latest_status);
+end;
+$$;
+revoke all on function public.my_verification_progress() from public, anon;
+grant execute on function public.my_verification_progress() to authenticated;
+commit;
-- 
